{
  "schema_version": "1.0",
  "targets": [
    {
      "id": "current-project",
      "enabled": true,
      "roles": [
        "authority"
      ],
      "kind": "authority-repository",
      "checkout": {
        "mode": "existing-path",
        "path": ".",
        "url": null,
        "branch": null,
        "expected_remote_url": "https://github.com/shnri/ai-development-issues.git"
      },
      "artifact_root": null,
      "default_branch": "main",
      "allowed_paths": [
        ".ai-intelligence/ai-development/**"
      ],
      "protected_paths": [
        ".env*",
        "**/.env*",
        "**/*secret*",
        "**/*credential*",
        ".git/**"
      ],
      "validation_commands": [
        "python3 scripts/check_authority.py"
      ],
      "release": {
        "strategy": "direct",
        "remote": "origin",
        "base_branch": "main",
        "branch_prefix": "ai-development-maintenance/"
      }
    },
    {
      "id": "shared-agent-plugins",
      "enabled": true,
      "roles": [
        "shared-assets"
      ],
      "kind": "shared-agent-repository",
      "checkout": {
        "mode": "git-clone",
        "path": ".ai-intelligence/ai-development/workspaces/shared-agent-plugins",
        "url": "https://github.com/shnri/shared-agent-plugins.git",
        "branch": "main",
        "expected_remote_url": "https://github.com/shnri/shared-agent-plugins.git"
      },
      "artifact_root": null,
      "default_branch": "main",
      "allowed_paths": [
        "skills/**",
        "agents/**",
        "hooks/**",
        "scripts/**",
        "references/**",
        "schemas/**",
        "evals/**",
        "plugin.json",
        ".claude-plugin/plugin.json",
        ".codex-plugin/plugin.json",
        "README.md",
        "CHANGELOG.md",
        "FILE-MANIFEST.sha256",
        "Makefile",
        "docs/**",
        "routines/**",
        "marketplace/**",
        "tests/**",
        "LICENSE",
        "**/skills/**",
        "**/agents/**",
        "**/hooks/**",
        "**/scripts/**",
        "**/references/**",
        "**/schemas/**",
        "**/evals/**",
        "**/plugin.json",
        "**/.claude-plugin/plugin.json",
        "**/.codex-plugin/plugin.json",
        "**/README.md",
        "**/CHANGELOG.md",
        "**/FILE-MANIFEST.sha256",
        "package.json",
        ".claude-plugin/marketplace.json",
        ".agents/plugins/marketplace.json",
        "**/examples/**",
        "**/tests/**",
        "**/docs/**",
        "**/routines/**",
        "**/Makefile",
        "**/LICENSE"
      ],
      "protected_paths": [
        ".env*",
        "**/.env*",
        "**/*secret*",
        "**/*credential*",
        ".git/**"
      ],
      "validation_commands": [
        "npm ci",
        "npm run check"
      ],
      "release": {
        "strategy": "direct",
        "remote": "origin",
        "base_branch": "main",
        "branch_prefix": "ai-development-improvement/"
      }
    }
  ],
  "routes": [
    {
      "match": {
        "scopes": [
          "global",
          "domain",
          "model"
        ],
        "remedy_types": [
          "instruction",
          "setting",
          "test-strategy",
          "process",
          "harness",
          "observability"
        ]
      },
      "target_id": "shared-agent-plugins"
    },
    {
      "match": {
        "scopes": [
          "project"
        ]
      },
      "target_id": "current-project"
    }
  ]
}
